generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contact {
  id          Int     @id @default(autoincrement())
  firstName   String
  lastName    String
  address     String
  image       String
  description String
  owner       String

  @@unique([firstName, lastName, owner], name: "firstName_lastName_owner")
}
